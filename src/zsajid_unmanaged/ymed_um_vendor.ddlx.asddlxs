@Metadata.layer: #CORE
@Search.searchable: true

// This metadata extension enriches the base RAP entity `YC_VENDOR_CONTRACT_UM` with
// UI and search annotations for the unmanaged scenario. It mirrors the managed
// `YC_VEND_CONTRACT` metadata but targets the unmanaged projection.
// The annotations tell Fiori Elements how to render the object page, which fields
// are searchable, which fields belong to each section, and which fields appear in
// line items, forms, and identification areas.

@UI.headerInfo: {
    typeName: 'Vendor Contract',
    typeNamePlural: 'Vendor Contracts',
    title: {
        value: 'contract_id'
    },
    description: {
        value: 'contract_title'
    }
}
annotate entity YC_VENDOR_CONTRACT_UM with
{
  // Facets define the layout of the object page. Each facet points to a
  // section (Identification, Field Group, etc.) via a qualifier so Fiori
  // Elements knows where to render the fields in the UI.
  @UI.facet: [{ position: 10, id: 'generalInfo',  label: 'General Information', targetQualifier: 'GENERAL', type: #IDENTIFICATION_REFERENCE },
              { position: 20, id: 'contractInfo', label: 'Contract Details', targetQualifier: 'CONTRACT', type: #FIELDGROUP_REFERENCE },
              { position: 30, id: 'approvalInfo', label: 'Approval Details', targetQualifier: 'APPROVAL', type: #FIELDGROUP_REFERENCE },
              { position: 40, id: 'auditInfo',    label: 'Audit Details', targetQualifier: 'AUDIT', type: #IDENTIFICATION_REFERENCE }]

  // Identification actions become object-page actions in the UI. The
  // `dataAction` names map to RAP actions implemented in the behavior definition.
  @UI.identification: [{ position: 10, label: 'Submit',  type: #FOR_ACTION, dataAction: 'submit' },
                       { position: 20, label: 'Approve', type: #FOR_ACTION, dataAction: 'approve' },
                       { position: 30, label: 'Reject',  type: #FOR_ACTION, dataAction: 'reject' }]

  // Hidden technical UUID used internally for persistence and entity identity.
  @EndUserText.label: 'UUID'
  @UI.hidden: true
  uuid;

  // Main business key. It is shown in list/reporting, used in search, and
  // placed in the GENERAL identification section so users can quickly identify
  // the contract record.
  @EndUserText.label: 'Contract ID'
  @UI.lineItem: [{ position: 10 }]
  @UI.selectionField: [{ position: 30 }]
  @Search.defaultSearchElement: true
  @UI.identification: [{ position: 10, qualifier: 'GENERAL' }]
  contract_id;

  // Vendor information displayed in the general section of the object page.
  @EndUserText.label: 'Vendor Number'
  @UI.identification: [{ position: 20, qualifier: 'GENERAL' }]
  vendor_id;

  @EndUserText.label: 'Vendor Name'
  @UI.lineItem: [{ position: 30 }]
  @UI.selectionField: [{ position: 10 }]
  @Search.defaultSearchElement: true
  @UI.identification: [{ position: 30, qualifier: 'GENERAL' }]
  vendor_name;

  // Contract title is used as a searchable descriptive field and shown in the
  // general identification section to help users distinguish contracts quickly.
  @EndUserText.label: 'Contract Title'
  @UI.lineItem: [{ position: 20 }]
  @Search.defaultSearchElement: true
  @UI.identification: [{ position: 40, qualifier: 'GENERAL' }]
  contract_title;

  // Contract details are grouped with the CONTRACT qualifier so they appear in
  // the Contract Details facet as a field group.
  @EndUserText.label: 'Contract Start Date'
  @UI.selectionField: [{ position: 40 }]
  @UI.fieldGroup: [{ position: 40, qualifier: 'CONTRACT' }]
  start_date;
  @EndUserText.label: 'Contract End Date'
  @UI.lineItem: [{ position: 60 }]
  @UI.selectionField: [{ position: 50 }]
  @UI.fieldGroup: [{ position: 50, qualifier: 'CONTRACT' }]
  end_date;
  @EndUserText.label: 'Last Review Date'
  last_review_date;
  @EndUserText.label: 'Contract Amount'
  @UI.lineItem: [{ position: 50 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'CONTRACT' }]
  contract_value;
  @EndUserText.label: 'Currency'
  @UI.fieldGroup: [{ position: 30, qualifier: 'CONTRACT' }]
  currency;

  // Status drives list highlighting and object page semantics. The criticality
  // binding tells the UI to color-code the status based on `status_criticality`.
  @EndUserText.label: 'Status'
  @UI.lineItem: [{ position: 40, criticality: 'status_criticality' }]
  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ criticality: 'status_criticality' }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'CONTRACT' }]
  status;
  @UI.hidden: true
  status_criticality;

  // Approval-related data is grouped under the APPROVAL qualifier so approvers
  // can focus on the data needed to decide whether the contract is approved.
  @EndUserText.label: 'Buyer ID'
  @UI.fieldGroup: [{ position: 10, qualifier: 'APPROVAL' }]
  buyer_id;
  @EndUserText.label: 'Approver ID'
  @UI.selectionField: [{ position: 60 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'APPROVAL' }]
  approver_id;
  @EndUserText.label: 'Renewal Required'
  @UI.lineItem: [{ position: 70 }]
  @UI.selectionField: [{ position: 70 }]
  @UI.fieldGroup: [{ position: 60, qualifier: 'CONTRACT' }]
  renewal_required;

  // Audit fields are read-only trace information showing who created/changed
  // the record and when. They are typically used for troubleshooting and audit.
  @EndUserText.label: 'Created By'
  @UI.identification: [{ position: 10, qualifier: 'AUDIT' }]
  created_by;
  @EndUserText.label: 'Created At'
  @UI.identification: [{ position: 20, qualifier: 'AUDIT' }]
  created_at;
  @EndUserText.label: 'Last Changed By'
  @UI.identification: [{ position: 30, qualifier: 'AUDIT' }]
  last_changed_by;
  @EndUserText.label: 'Last Changed At'
  @UI.identification: [{ position: 40, qualifier: 'AUDIT' }]
  last_changed_at;
  @UI.hidden: true
  @EndUserText.label: 'Local Last Changed At'
  @UI.identification: [{ position: 50, qualifier: 'AUDIT' }]
  local_last_changed_at;

}
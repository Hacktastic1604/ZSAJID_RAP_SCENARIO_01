// This BDEF declares an unmanaged implementation: persistence is handled by
// the developer code (class ````zbp_i_vendor_contract_um````) rather than by the
// managed runtime. In managed scenarios the framework handles INSERT/UPDATE/DELETE.
unmanaged implementation in class zbp_i_vendor_contract_um unique;

// 'strict (2)' defines the RAP draft behavior strictness level. In unmanaged
// mode we still declare strictness to control draft processing rules; managed
// services may choose defaults, but unmanaged makes developer responsibility
// explicit for enforcement and edge-cases.
strict ( 2 );

// 'with draft' enables draft handling for this behavior. In managed behavior
// the framework creates and manages draft tables automatically; for unmanaged
// we still declare draft support but the saver/handler must manage persistence.
with draft;

// Root entity mapping: the behavior is defined for the CDS root view
// ````YI_VENDOR_CONTRACT_UM````. In managed scenarios the behavior maps to a CDS
// and the framework wires persistence; here the mapping is explicit.
define behavior for YI_VENDOR_CONTRACT_UM alias vendor_contract

// Draft table name: in managed mode this would be generated by the runtime;
// here we specify the draft table ````zdraft_contract```` explicitly so the saver
// implementation knows where to stage draft data.
draft table zdraft_contract

// Locking and etag strategy: 'lock master total' and 'etag local_last_changed_at'
// indicate how concurrent access and optimistic locking are handled. Managed
// implementations may use defaults; unmanaged requires explicit decisions so
// the developer and the DB schema align on locking fields.
lock master total etag local_last_changed_at

// Authorization is declared at 'instance' (per-entity) level. In unmanaged
// scenarios the handler must enforce these authorizations; managed runtime
// can enforce more automatically when backed by standard services.
authorization master ( instance )

// Declare which field acts as ETag for optimistic locking. In unmanaged
// implementations, the saver must update ````last_changed_at```` consistently to
// make ETag checks meaningful; managed mode often automates this.
etag master last_changed_at

// Begin the behavior definition block. Each element below controls operations
// and validations. Comments explain how unmanaged differs from managed.
{
  // Create is allowed and requires global authorization: unlike managed where
  // the framework can supply default authorizations, here we declare intent
  // and expect the handler or external auth checks to enforce it.
  create ( authorization : global );

  // Update and delete are declared without extra features; in unmanaged
  // implementations the handler methods must implement concurrency checks
  // and persist changes to the active table (save() implementation).
  update;
  delete;

  // UUID is read-only (key). In managed scenarios, keys and generated values
  // might be handled by the framework; here the handler must generate UUIDs
  // on create (see the create method in the handler implementation).
  field ( readonly ) uuid;

  // Audit fields are readonly from the behavior perspective. For unmanaged
  // implementations the handler is responsible for populating created_by/at
  // and last_changed_by/at fields when persisting drafts to the active table.
  field ( readonly ) created_by, created_at, last_changed_by, last_changed_at, local_last_changed_at;

  // Draft lifecycle actions declared. In managed mode the framework often
  // provides standardized optimized activation; in unmanaged we declare the
  // same actions but the class implementation must perform activation logic.
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;

  // A preparatory determination action — this groups validations that the
  // saver should call before finalizing activation. In managed setups the
  // framework wires validations automatically; here the BDEF documents the
  // intended flow and the handler implements it.
  draft determine action Prepare
  {
    // Validation methods referenced here must be implemented in the handler
    // and invoked by the saver or runtime during save/activation. Managed
    // services often provide more automation for invocation order.
    validation validateDates;
    validation validateAmount;
  }

  // Determinations execute business logic during modify/create. In unmanaged
  // implementations the developer controls when determinations run; the BDEF
  // documents that ````setInitialDefaultStatus```` runs on create.
  determination setInitialDefaultStatus on modify { create; }

  // Renewal flag calculation is triggered on end_date changes. The BDEF
  // documents the intent; the handler must implement calculateRenewalFlag
  // to update derived fields in the draft/change buffer.
  determination calculateRenewalFlag on modify { field end_date; }

  // Save-time validations: the handler must ensure these validations run on
  // create and update before the saver commits. Managed runtime can execute
  // validations more automatically based on annotations.
  validation validateDates on save { create; update; }
  validation validateAmount on save { create; update; }

  // Side effects tell the runtime which fields affect others. In managed
  // mode this helps generated UIs and propagation; in unmanaged it's a guide
  // so the implementation keeps derived fields consistent.
  side effects
  {
    field end_date affects field renewal_required;
  }

  // Instance-level actions with their result types. The handler needs to
  // implement these actions and return the requested result shapes. Managed
  // implementations may wire common action semantics, but unmanaged leaves it
  // to the developer.
  action ( features : instance ) submit result [1] $self;
  action ( features : instance ) approve result [1] $self;
  action ( features : instance ) reject result [1] $self;

}
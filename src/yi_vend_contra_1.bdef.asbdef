// RAP managed implementation: business logic is implemented in ABAP class

// Alternative: unmanaged implementation for custom
// persistence and save logic.
managed implementation in class zbp_i_vend_contra1 unique;

// Strictness level 2 enables stronger syntax/consistency checks.
// Alternative: lower strictness or no strictness, but with fewer safeguards.
strict ( 2 );

// Draft support allows users to create/edit in draft before activation.
// Alternative: no draft, meaning direct-save behavior only.
with draft;

// Define the behavior for the interface view entity.

define behavior for YI_VEND_CONTRA_1 alias vendor_contract1


persistent table yvend_contra_1


// Draft instances are stored separately while the user edits data.
// Alternative: no draft table if draft mode is not required.
draft table zdraft_contract

// Total lock prevents concurrent editing of the whole BO root.
// Alternative lock modes exist, but total lock is safest for this BO.
lock master total etag local_last_changed_at

// Instance-based authorization allows checks per contract record.
// Alternative: global authorization or no authorization control.
authorization master ( instance )

// ETag provides optimistic concurrency control using last_changed_at.
// Alternative: another timestamp/hash field or no ETag control.
etag master last_changed_at
{
  // Create is allowed; global authorization is checked for create.
  // Alternative: restrict create further or remove create entirely.
  create ( authorization : global );

  // Update existing active records.
  update;

  // Delete existing active records.
  // Alternative: forbid delete and use status-based cancellation.
  delete;

  // Technical UUID key, read-only, auto-numbered by RAP.
  // Alternative: unmanaged/manual numbering if business needs require it.
  field ( readonly, numbering : managed ) uuid;

  // Audit and local technical fields are read-only because the framework
  // or database maintains them.
  field ( readonly ) created_by, created_at, last_changed_by, last_changed_at, local_last_changed_at;

  // Built-in draft lifecycle actions.
  // Alternative: omit draft support if you want direct persistence only.
  draft action Activate optimized;

  // Discard removes draft changes.
  draft action Discard;

  // Edit opens an active record in draft mode for changes.
  draft action Edit;

  // Resume continues an interrupted draft session.
  draft action Resume;

  // Prepare runs before activation and gives early validation feedback.
  // Alternative: validate only on save, but Prepare improves UX.
  draft determine action Prepare
  {
    // Validate both business rules during draft preparation.
    validation validateDates;
    validation validateAmount;
  }

  // Derive default status during modify/create.
  // Alternative: set status in UI or on save, but determination keeps it automatic.
  determination setInitialDefaultStatus on modify { create; }

  // Recalculate renewal flag when end date changes.
  // Alternative trigger: on save or other field change.
  determination calculateRenewalFlag on modify { field end_date; }

  // Save-time validation as final safety net.
  // Alternative: keep only Prepare validation, but save validation is safer.
  validation validateDates on save { create; update; }

  // Ensure contract amount is positive on create and update.
  // Alternative: allow zero/negative values only if business rules change.
  validation validateAmount on save { create; update; }

  // End date affects renewal flag; side effects tell the UI/runtime to refresh it.
  // Alternative: manual refresh logic, but side effects are RAP-native.
  side effects
  {
    field end_date affects field renewal_required;
  }

  // Instance-feature actions are enabled/disabled dynamically by record status.
  // Alternative: always show actions, but feature control prevents invalid steps.
  action ( features : instance ) submit result [1] $self;

  // Approve returns the updated instance after changing the status.
  action ( features : instance ) approve result [1] $self;

  // Reject also returns the updated instance so the UI can refresh immediately.
  action ( features : instance ) reject result [1] $self;
}